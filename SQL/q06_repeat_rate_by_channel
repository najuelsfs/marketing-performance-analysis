WITH user_orders AS (
  SELECT
    user_id,
    COUNT(DISTINCT order_id) AS orders
  FROM `bigquery-public-data.thelook_ecommerce.order_items`
  GROUP BY user_id
)
SELECT
  u.traffic_source,
  COUNT(*) AS buyers,
  COUNTIF(o.orders > 1) AS repeat_buyers,
  SAFE_DIVIDE(COUNTIF(o.orders > 1), COUNT(*)) AS repeat_rate
FROM `bigquery-public-data.thelook_ecommerce.users` u
JOIN user_orders o
  ON u.id = o.user_id
GROUP BY u.traffic_source
ORDER BY repeat_rate DESC;
