WITH user_orders AS (
  SELECT
    user_id,
    COUNT(DISTINCT order_id) AS orders,
    SUM(sale_price) AS total_revenue
  FROM `bigquery-public-data.thelook_ecommerce.order_items`
  GROUP BY user_id
),
classified_users AS (
  SELECT
    user_id,
    CASE
      WHEN orders = 1 THEN 'One-time'
      ELSE 'Repeat'
    END AS customer_type,
    total_revenue
  FROM user_orders
)
SELECT
  u.traffic_source,
  cu.customer_type,
  COUNT(DISTINCT u.id) AS users,
  SUM(cu.total_revenue) AS revenue,
  AVG(cu.total_revenue) AS avg_revenue_per_user
FROM `bigquery-public-data.thelook_ecommerce.users` u
LEFT JOIN classified_users cu
  ON u.id = cu.user_id
GROUP BY u.traffic_source, cu.customer_type
ORDER BY u.traffic_source, cu.customer_type;
